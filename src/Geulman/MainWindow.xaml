<Window x:Class="Geulman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="글만"
        Width="780" Height="640"
        MinWidth="560" MinHeight="420"
        Background="{StaticResource PaperBrush}">

    <Grid>
        <!-- ═══ 상태 1: 처음 (드롭존 + 최근 문서) ═══ -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="글만" FontFamily="{StaticResource UIFont}" FontSize="32" FontWeight="600"
                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="원본 형식으로 읽고, 원본 형식으로 저장합니다."
                       FontFamily="{StaticResource UIFont}" FontSize="14"
                       Foreground="{StaticResource InkBrush}" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,8,0,24" />

            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.5"
                    CornerRadius="8" Padding="48,32">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="문서를 여기에 놓거나" FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource InkBrush}" Opacity="0.5" HorizontalAlignment="Center" />
                    <Button x:Name="BrowseBtn" Content="파일 열기" Click="BrowseBtn_Click"
                            Style="{StaticResource BaseButton}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="최근 문서" FontFamily="{StaticResource UIFont}" FontSize="12"
                       Foreground="{StaticResource InkBrush}" Opacity="0.4"
                       HorizontalAlignment="Center" Margin="0,20,0,8" />
            <ItemsControl x:Name="RecentList" MaxHeight="120">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="RecentItem_Click" Tag="{Binding}"
                                Style="{StaticResource BaseButton}"
                                Content="{Binding}" HorizontalContentAlignment="Left" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ═══ 상태 2: 편집 (상단 바 + 본문 + 하단 바) ═══ -->
        <Grid x:Name="EditState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 상단 바 -->
            <Border Grid.Row="0" Padding="20,14">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Text="" FontFamily="{StaticResource UIFont}"
                               FontSize="13" FontWeight="500" Foreground="{StaticResource InkBrush}" />
                    <Border x:Name="FormatBadge" Background="{StaticResource HairlineBrush}"
                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="FormatText" Text="" FontFamily="{StaticResource UIFont}"
                                   FontSize="11" Foreground="{StaticResource InkBrush}" Opacity="0.7" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="CharCountText" Grid.Column="1" Text=""
                           FontFamily="{StaticResource UIFont}" FontSize="12"
                           Foreground="{StaticResource InkBrush}" Opacity="0.4" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 본문 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="BodyEditor" FontFamily="{StaticResource BodyFont}"
                         FontSize="16" Foreground="{StaticResource InkBrush}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent"
                         Margin="48,8" VerticalScrollBarVisibility="Auto" />
            </ScrollViewer>

            <!-- 하단 바 -->
            <Border Grid.Row="2" Padding="20,12">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="" FontFamily="{StaticResource UIFont}"
                           FontSize="12" Foreground="{StaticResource InkBrush}" Opacity="0.5"
                           VerticalAlignment="Center" />
                <Button x:Name="FindReplaceBtn" Grid.Column="1" Content="찾기·바꾸기"
                        Click="FindReplaceBtn_Click" Style="{StaticResource BaseButton}" Margin="0,0,10,0" />
                <Button x:Name="SaveBtn" Grid.Column="2" Content="저장"
                        Click="SaveBtn_Click" Style="{StaticResource AccentButton}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 상태 3: 저장 후 토스트 ═══ -->
        <Border x:Name="Toast" IsHitTestVisible="False"
                Background="#E8F5E9" CornerRadius="8" Padding="20,14"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" FontSize="16" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="ToastText" Text="원본 형식으로 저장했습니다 — 서식·코멘트·변경 사항 보존됨."
                           FontFamily="{StaticResource UIFont}" FontSize="13" Foreground="#1B5E20" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
