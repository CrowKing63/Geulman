<Window x:Class="Geulman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="글만">
    <Grid Background="{StaticResource PaperBrush}">
        <!-- State 1: Empty -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
            <TextBlock Text="글만" FontFamily="{StaticResource UIFont}" FontSize="32" FontWeight="600"
                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="원본 형식으로 읽고, 원본 형식으로 저장합니다."
                       FontFamily="{StaticResource UIFont}" FontSize="14"
                       Foreground="{StaticResource InkBrush}" Opacity="0.6"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1.5"
                    CornerRadius="8" Padding="48,32">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="문서를 여기에 놓거나" FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource InkBrush}" Opacity="0.5" HorizontalAlignment="Center" />
                    <Button x:Name="BrowseBtn" Content="파일 열기" Click="BrowseBtn_Click"
                            MinHeight="42" Padding="24,8" CornerRadius="6"
                            FontFamily="{StaticResource UIFont}" FontSize="14"
                            Background="#3457D5" Foreground="White"
                            BorderBrush="#3457D5" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- State 2: Edit -->
        <Grid x:Name="EditState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Text="" FontFamily="{StaticResource UIFont}"
                               FontSize="13" FontWeight="500" Foreground="{StaticResource InkBrush}" />
                    <Border Background="{StaticResource HairlineBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="FormatText" Text="" FontFamily="{StaticResource UIFont}"
                                   FontSize="11" Foreground="{StaticResource InkBrush}" Opacity="0.7" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="CharCountText" Grid.Column="1" Text=""
                           FontFamily="{StaticResource UIFont}" FontSize="12"
                           Foreground="{StaticResource InkBrush}" Opacity="0.4" VerticalAlignment="Center" />
            </Grid>

            <!-- Find/Replace inline panel -->
            <Border x:Name="FindPanel" Grid.Row="1" Visibility="Collapsed"
                    Background="#F0F0EE" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" Grid.Column="0" PlaceholderText="찾을 문구"
                             FontFamily="{StaticResource UIFont}" FontSize="13"
                             Foreground="{StaticResource InkBrush}" MinHeight="36" Padding="10,6" />
                    <TextBox x:Name="ReplaceBox" Grid.Column="1" PlaceholderText="바꿀 문구"
                             FontFamily="{StaticResource UIFont}" FontSize="13"
                             Foreground="{StaticResource InkBrush}" MinHeight="36" Padding="10,6"
                             Margin="8,0,8,0" />
                    <Button x:Name="ReplaceAllBtn" Grid.Column="2" Content="모두 바꾸기"
                            Click="ReplaceAllBtn_Click" MinHeight="36" Padding="16,6" CornerRadius="6"
                            FontFamily="{StaticResource UIFont}" FontSize="13" />
                    <Button x:Name="CloseFindBtn" Grid.Column="3" Content="x"
                            Click="CloseFindBtn_Click" MinHeight="36" Width="36" CornerRadius="6"
                            FontFamily="{StaticResource UIFont}" FontSize="16"
                            Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- Editor -->
            <ScrollViewer Grid.Row="2" Padding="48,8">
                <TextBox x:Name="BodyEditor" FontFamily="{StaticResource BodyFont}"
                         FontSize="16" Foreground="{StaticResource InkBrush}"
                         AcceptsReturn="True" TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="3" Padding="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="" FontFamily="{StaticResource UIFont}"
                           FontSize="12" Foreground="{StaticResource InkBrush}" Opacity="0.5"
                           VerticalAlignment="Center" />
                <Button x:Name="FindReplaceBtn" Grid.Column="1" Content="찾기·바꾸기"
                        Click="FindReplaceBtn_Click" MinHeight="42" Padding="20,8" CornerRadius="6"
                        FontFamily="{StaticResource UIFont}" FontSize="13" Margin="0,0,10,0" />
                <Button x:Name="SaveBtn" Grid.Column="2" Content="저장"
                        Click="SaveBtn_Click" MinHeight="42" Padding="28,8" CornerRadius="6"
                        FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="600"
                        Background="{StaticResource AccentBrush}" Foreground="White" />
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" IsHitTestVisible="False"
                Background="#E8F5E9" CornerRadius="8" Padding="20,14"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="✓" FontSize="16" Foreground="#2E7D32" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Text="원본 형식으로 저장했습니다 — 서식·코멘트·변경 사항 보존됨."
                           FontFamily="{StaticResource UIFont}" FontSize="13" Foreground="#1B5E20" />
            </StackPanel>
        </Border>
    </Grid>
</Window>